# ─────────────────────────────────────────────────────────────
# Pause
# ─────────────────────────────────────────────────────────────

pause() {
    echo

    gum input \
        --placeholder "$(t press_enter)" \
        >/dev/null || true
}

# ─────────────────────────────────────────────────────────────
# Error handling
# ─────────────────────────────────────────────────────────────

handle_error() {
    local exit_code=$?
    local line_number=$1

    echo

    if command_exists gum; then
        gum style \
            --border rounded \
            --border-foreground "$RED" \
            --foreground "$RED" \
            --padding "1 2" \
            "$(t error_title)" \
            "$(t line): $line_number" \
            "$(t exit_code): $exit_code" \
            "$(t log_location): $LOG_FILE"
    else
        echo "$(t error_title)"
        echo "$(t line): $line_number"
        echo "$(t exit_code): $exit_code"
        echo "$(t log_location): $LOG_FILE"
    fi

    log "ERROR line=$line_number exit_code=$exit_code"

    exit "$exit_code"
}

trap 'handle_error $LINENO' ERR

# ─────────────────────────────────────────────────────────────
# Root check
# ─────────────────────────────────────────────────────────────

require_root() {
    if ! is_root; then
        echo
        echo "$(t root_required)"
        echo
        echo "$(t run_with)"
        echo
        echo "    sudo $0"
        echo
        exit 1
    fi
}

# ─────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────

prepare_logs() {
    mkdir -p "$LOG_DIR"
    touch "$LOG_FILE"

    chmod 755 "$LOG_DIR"
    chmod 640 "$LOG_FILE"

    log "========================================"
    log "$APP_NAME $VERSION started"
}

# ─────────────────────────────────────────────────────────────
# Base dependencies
# ─────────────────────────────────────────────────────────────

install_base_dependencies() {

    local missing_packages=()

    if ! command_exists curl; then
        missing_packages+=("curl")
    fi

    if ! command_exists gpg; then
        missing_packages+=("gnupg")
    fi

    if ((${#missing_packages[@]} > 0)); then

        echo
        echo "$(t installing_dependencies)"

        apt-get update -qq

        DEBIAN_FRONTEND=noninteractive \
            apt-get install -y "${missing_packages[@]}"
    fi
}

# ─────────────────────────────────────────────────────────────
# Gum installation
# ─────────────────────────────────────────────────────────────

install_gum() {

    if command_exists gum; then
        return
    fi

    clear

    echo
    echo "======================================================"
    echo "                  KALI UPDATER SETUP"
    echo "======================================================"
    echo
    echo "$(t gum_required)"
    echo "$(t gum_installing)"
    echo

    log "Gum not found. Installing."

    install_base_dependencies

    mkdir -p /etc/apt/keyrings

    curl -fsSL https://repo.charm.sh/apt/gpg.key \
        | gpg --dearmor --yes -o "$CHARM_KEYRING"

    chmod 644 "$CHARM_KEYRING"

    echo \
        "deb [signed-by=$CHARM_KEYRING] https://repo.charm.sh/apt/ * *" \
        > "$CHARM_REPO"

    apt-get update -qq

    DEBIAN_FRONTEND=noninteractive \
        apt-get install -y gum

    if ! command_exists gum; then
        echo
        echo "$(t gum_failed)"
        exit 1
    fi

    echo
    echo "$(t gum_success)"

    sleep 1
}

# ─────────────────────────────────────────────────────────────
# Language selection
# ─────────────────────────────────────────────────────────────

choose_language() {

    clear

    gum style \
        --border double \
        --border-foreground "$PURPLE" \
        --foreground "$PURPLE" \
        --align center \
        --width 58 \
        --padding "1 3" \
        "KALI SYSTEM UPDATER" \
        "Language / Idioma"

    echo

    local choice

    choice="$(
        gum choose \
            --cursor.foreground "$PURPLE" \
            --selected.foreground "$CYAN" \
            "English" \
            "Portugues"
    )" || exit 0

    case "$choice" in
        "English")
            LANGUAGE="en"
            ;;
        "Portugues")
            LANGUAGE="pt"
            ;;
    esac

    log "Language selected: $LANGUAGE"
}

# ─────────────────────────────────────────────────────────────
# UI helpers
# ─────────────────────────────────────────────────────────────

header() {

    clear

    gum style \
        --border double \
        --border-foreground "$PURPLE" \
        --foreground "$PURPLE" \
        --align center \
        --width 62 \
        --padding "1 3" \
        "KALI SYSTEM UPDATER" \
        "v$VERSION"

    echo

    gum style \
        --align center \
        --width 62 \
        --foreground "$GRAY" \
        "$(t app_subtitle)"

    echo
}

section() {
    echo

    gum style \
        --bold \
        --foreground "$CYAN" \
        ":: $1"

    echo
}

success() {
    gum style --foreground "$GREEN" "[OK] $1"
}

warning() {
    gum style --foreground "$YELLOW" "[WARN] $1"
}

error_message() {
    gum style --foreground "$RED" "[ERROR] $1"
}

info() {
    gum style --foreground "$CYAN" "> $1"
}

# ─────────────────────────────────────────────────────────────
# Task runner
# ─────────────────────────────────────────────────────────────

run_task() {

    local title="$1"
    shift

    log "Running: $*"

    if gum spin \
        --spinner dot \
        --spinner.foreground "$PURPLE" \
        --title "$title" \
        --title.foreground "$WHITE" \
        --show-output=false \
        -- "$@" >>"$LOG_FILE" 2>&1
    then
        success "$title"
        log "SUCCESS: $title"
    else
        error_message "$title $(t task_failed)"
        log "FAILED: $title"

        echo

        gum style \
            --foreground "$GRAY" \
            "$(t check_log)" \
            "$LOG_FILE"

        return 1
    fi
}

# ─────────────────────────────────────────────────────────────
# Internet check
# ─────────────────────────────────────────────────────────────

check_internet() {

    if ping -c 1 -W 2 1.1.1.1 >/dev/null 2>&1; then
        return 0
    fi

    if curl -Is --max-time 5 https://http.kali.org \
        >/dev/null 2>&1; then
        return 0
    fi

    return 1
}

# ─────────────────────────────────────────────────────────────
# System information
# ─────────────────────────────────────────────────────────────

system_information() {

    header
    section "$(t system_info_title)"

    local hostname_value
    local kernel_value
    local architecture
    local uptime_value
    local disk_value
    local memory_value
    local ip_value

    hostname_value="$(hostname)"
    kernel_value="$(uname -r)"
    architecture="$(uname -m)"
    uptime_value="$(uptime -p 2>/dev/null || echo "Unknown")"

    disk_value="$(
        df -h / \
            | awk 'NR==2 {print $4 " free / " $2}'
    )"

    memory_value="$(
        free -h \
            | awk '/Mem:/ {print $3 " used / " $2}'
    )"

    ip_value="$(
        hostname -I 2>/dev/null \
            | awk '{print $1}'
    )"

    [[ -z "$ip_value" ]] && ip_value="N/A"

    gum table \
        --border rounded \
        --border.foreground "$PURPLE" \
        --header.foreground "$CYAN" \
        --cell.foreground "$WHITE" \
        --columns "$(t property),$(t value)" \
        --widths 18,37 \
        --separator "," <<EOF
$(t hostname),$hostname_value
$(t kernel),$kernel_value
$(t architecture),$architecture
$(t uptime),$uptime_value
$(t memory),$memory_value
$(t disk),$disk_value
$(t local_ip),$ip_value
EOF

    pause
}

# ─────────────────────────────────────────────────────────────
# Pre-flight
# ─────────────────────────────────────────────────────────────

preflight_check() {

    header
    section "$(t preflight_title)"

    if check_internet; then
        success "$(t internet_available)"
    else
        error_message "$(t no_internet)"
        pause
        return 1
    fi

    local available_kb
    local available_gb

    available_kb="$(
        df / --output=avail \
            | tail -1 \
            | tr -d ' '
    )"

    available_gb=$((available_kb / 1024 / 1024))

    if ((available_gb < 2)); then
        warning "$(t low_disk): ${available_gb} GB"
    else
        success "$(t disk_available): ${available_gb} GB"
    fi

    if dpkg --audit | grep -q .; then
        warning "$(t package_db_problem)"
    else
        success "$(t package_db_healthy)"
    fi

    if [[ -f /var/lib/dpkg/lock-frontend ]] &&
       fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1; then

        warning "$(t apt_busy)"

    else

        success "$(t apt_available)"

    fi

    pause
}

# ─────────────────────────────────────────────────────────────
# Update repositories
# ─────────────────────────────────────────────────────────────

update_repositories() {

    header
    section "$(t repositories_title)"

    run_task \
        "$(t refreshing_repositories)" \
        apt-get update

    echo

    local upgrade_count

    upgrade_count="$(
        apt list --upgradable 2>/dev/null \
            | tail -n +2 \
            | wc -l \
            | tr -d ' '
    )"

    if ((upgrade_count == 0)); then

        success "$(t already_updated)"

    else

        info "$upgrade_count $(t packages_available)"

        echo

        apt list --upgradable 2>/dev/null \
            | tail -n +2 \
            | head -20 \
            | gum format

        if ((upgrade_count > 20)); then
            echo
            info "$(t showing_first_20)"
        fi
    fi

    pause
}

# ─────────────────────────────────────────────────────────────
# Full upgrade
# ─────────────────────────────────────────────────────────────

full_upgrade() {

    header
    section "$(t upgrade_title)"

    run_task \
        "$(t refreshing)" \
        apt-get update

    local upgrade_count

    upgrade_count="$(
        apt list --upgradable 2>/dev/null \
            | tail -n +2 \
            | wc -l \
            | tr -d ' '
    )"

    if ((upgrade_count == 0)); then

        success "$(t no_upgrades)"
        pause
        return

    fi

    info "$upgrade_count $(t packages_ready)"

    echo

    if gum confirm \
        --affirmative "$(t upgrade)" \
        --negative "$(t cancel)" \
        "$(t run_full_upgrade)"
    then

        echo

        run_task \
            "$(t upgrading_system)" \
            apt-get full-upgrade -y

        echo

        success "$(t upgrade_completed)"

    else

        warning "$(t upgrade_cancelled)"

    fi

    pause
}

# ─────────────────────────────────────────────────────────────
# Cleanup
# ─────────────────────────────────────────────────────────────

cleanup_system() {

    header
    section "$(t cleanup_title)"

    gum style \
        --foreground "$GRAY" \
        "$(t cleanup_description)"

    echo

    if ! gum confirm \
        --affirmative "$(t clean)" \
        --negative "$(t cancel)" \
        "$(t continue)"
    then

        warning "$(t cleanup_cancelled)"
        pause
        return

    fi

    echo

    run_task \
        "$(t removing_unused)" \
        apt-get autoremove -y

    run_task \
        "$(t cleaning_cache)" \
        apt-get autoclean

    success "$(t cleanup_completed)"

    pause
}

# ─────────────────────────────────────────────────────────────
# Repair packages
# ─────────────────────────────────────────────────────────────

repair_packages() {

    header
    section "$(t repair_title)"

    warning "$(t repair_warning)"

    echo

    if ! gum confirm \
        --affirmative "$(t repair)" \
        --negative "$(t cancel)" \
        "$(t repair_question)"
    then
        return
    fi

    echo

    run_task \
        "$(t configuring_packages)" \
        dpkg --configure -a

    run_task \
        "$(t repairing_dependencies)" \
        apt-get --fix-broken install -y

    run_task \
        "$(t refreshing)" \
        apt-get update

    success "$(t package_repair_completed)"

    pause
}

# ─────────────────────────────────────────────────────────────
# Complete update
# ─────────────────────────────────────────────────────────────

complete_update() {

    header

    gum style \
        --border rounded \
        --border-foreground "$PURPLE" \
        --padding "1 2" \
        --foreground "$WHITE" \
        "$(t complete_maintenance)" \
        "" \
        "$(t this_will)" \
        "$(t step_update_repo)" \
        "$(t step_full_upgrade)" \
        "$(t step_remove_unused)" \
        "$(t step_clean_cache)"

    echo

    if ! gum confirm \
        --affirmative "$(t start)" \
        --negative "$(t cancel)" \
        "$(t continue)"
    then
        return
    fi

    header
    section "$(t step1)"

    run_task \
        "$(t updating_repositories)" \
        apt-get update

    section "$(t step2)"

    run_task \
        "$(t upgrading)" \
        apt-get full-upgrade -y

    section "$(t step3)"

    run_task \
        "$(t removing_packages)" \
        apt-get autoremove -y

    section "$(t step4)"

    run_task \
        "$(t cleaning_apt)" \
        apt-get autoclean

    echo

    final_status

    pause
}

# ─────────────────────────────────────────────────────────────
# Final status
# ─────────────────────────────────────────────────────────────

final_status() {

    section "$(t final_status)"

    local remaining

    remaining="$(
        apt list --upgradable 2>/dev/null \
            | tail -n +2 \
            | wc -l \
            | tr -d ' '
    )"

    if ((remaining == 0)); then

        success "$(t fully_updated)"

    else

        warning "$remaining $(t packages_remaining)"

    fi

    if dpkg --audit | grep -q .; then

        warning "$(t dpkg_issue)"

    else

        success "$(t package_db_healthy)"

    fi

    if [[ -f /var/run/reboot-required ]]; then

        echo

        warning "$(t reboot_recommended)"

        if gum confirm \
            --affirmative "$(t reboot)" \
            --negative "$(t later)" \
            "$(t reboot_now)"
        then

            log "User requested reboot."
            reboot

        fi

    else

        success "$(t no_reboot)"

    fi
}

# ─────────────────────────────────────────────────────────────
# View logs
# ─────────────────────────────────────────────────────────────

view_log() {

    header
    section "$(t log_title)"

    if [[ ! -s "$LOG_FILE" ]]; then

        warning "$(t log_empty)"
        pause
        return

    fi

    tail -n 100 "$LOG_FILE" \
        | gum pager \
            --border rounded \
            --border.foreground "$PURPLE"
}

# ─────────────────────────────────────────────────────────────
# About
# ─────────────────────────────────────────────────────────────

about() {

    header

    gum style \
        --border rounded \
        --border-foreground "$PURPLE" \
        --padding "1 3" \
        --width 58 \
        --align center \
        "$APP_NAME" \
        "" \
        "Version $VERSION" \
        "" \
        "$(t about_description)" \
        "" \
        "$(t created_by)" \
        "$(t github_profile)" \
        "" \
        "$(t powered_by)"

    pause
}

# ─────────────────────────────────────────────────────────────
# Main menu
# ─────────────────────────────────────────────────────────────

main_menu() {

    while true; do

        header

        info "$(t choose_action)"

        echo

        local choice

        choice="$(
            gum choose \
                --cursor.foreground "$PURPLE" \
                --selected.foreground "$CYAN" \
                --height 12 \
                "$(t complete_update)" \
                "$(t update_repositories)" \
                "$(t full_upgrade)" \
                "$(t clean_system)" \
                "$(t repair_packages)" \
                "$(t system_information)" \
                "$(t preflight_check)" \
                "$(t view_log)" \
                "$(t about)" \
                "$(t exit)"
        )" || exit 0

        case "$choice" in

            "$(t complete_update)")
                complete_update
                ;;

            "$(t update_repositories)")
                update_repositories
                ;;

            "$(t full_upgrade)")
                full_upgrade
                ;;

            "$(t clean_system)")
                cleanup_system
                ;;

            "$(t repair_packages)")
                repair_packages
                ;;

            "$(t system_information)")
                system_information
                ;;

            "$(t preflight_check)")
                preflight_check
                ;;

            "$(t view_log)")
                view_log
                ;;

            "$(t about)")
                about
                ;;

            "$(t exit)")

                clear

                gum style \
                    --foreground "$PURPLE" \
                    --bold \
                    "$(t goodbye)"

                echo

                log "$APP_NAME closed normally"

                exit 0
                ;;
        esac
    done
}

# ─────────────────────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────────────────────

main() {

    require_root
    prepare_logs

    install_base_dependencies
    install_gum

    choose_language

    log "Dependencies ready"

    main_menu
}

main "$@"
